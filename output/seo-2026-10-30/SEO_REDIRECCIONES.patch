diff --git a/.htaccess b/.htaccess
index a3d672f..8f68d81 100644
--- a/.htaccess
+++ b/.htaccess
@@ -7,21 +7,26 @@
   RewriteEngine On
   RewriteBase /
 
+  # El proxy termina TLS: usar el origen HTTPS canónico solo en el dominio público.
+  # En localhost y otros entornos se conservan los destinos relativos.
+  RewriteCond %{HTTP_HOST} ^(?:www\.)?odiseacloud\.com(?::[0-9]+)?$ [NC]
+  RewriteRule ^ - [E=SEO_REDIRECT_ORIGIN:https://odiseacloud.com]
+
   # Normalizar index ANTES de la regla general .html para evitar /index/ y bucles.
   RewriteCond %{THE_REQUEST} \s/+(.*/)?index(?:\.html)?(?:[?\s]) [NC]
-  RewriteRule ^(.*/)?index(?:\.html)?$ /$1 [R=301,L,NE]
+  RewriteRule ^(.*/)?index(?:\.html)?$ %{ENV:SEO_REDIRECT_ORIGIN}/$1 [R=301,L,NE]
 
   # Corregir también las variantes /index/ que pudieron quedar enlazadas.
-  RewriteRule ^(.*/)?index/?$ /$1 [R=301,L,NE]
+  RewriteRule ^(.*/)?index/?$ %{ENV:SEO_REDIRECT_ORIGIN}/$1 [R=301,L,NE]
 
   # 1. Redirigir solicitudes que escriban explícitamente .html a la URL limpia (301)
   RewriteCond %{THE_REQUEST} \s/+[^?\s]+\.html(?:[?\s]) [NC]
-  RewriteRule ^([^.]+)\.html$ /$1/ [R=301,L]
+  RewriteRule ^([^.]+)\.html$ %{ENV:SEO_REDIRECT_ORIGIN}/$1/ [R=301,L]
 
   # 3. Si se solicita un directorio sin barra final, añadir la barra final
   RewriteCond %{REQUEST_FILENAME} -d
   RewriteCond %{REQUEST_URI} !(.*)/$
-  RewriteRule ^(.*)$ $1/ [R=301,L]
+  RewriteRule ^(.*)$ %{ENV:SEO_REDIRECT_ORIGIN}/$1/ [R=301,L]
 
   # 4. Si el archivo existe directamente, servirlo
   RewriteCond %{REQUEST_FILENAME} -f
